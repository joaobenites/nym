# Copie para .env e ajuste. Nenhum segredo é necessário na Fase 1.
NYM_MODEL=llama3.2
# Para comparar cérebros: python -m app.brain_check qwen3.5:9b gemma4:12b-it-qat (ver README, 9.4)
NYM_OLLAMA_URL=http://127.0.0.1:11434
NYM_DATA_DIR=data
NYM_HOST=127.0.0.1
NYM_PORT=8000
NYM_CONTEXT_MESSAGES=20
NYM_CONTEXT_CHARS=12000
NYM_REQUEST_TIMEOUT=120
NYM_LOG_LEVEL=INFO

# Identidade: orçamento (em caracteres) da identidade enviada ao modelo
NYM_IDENTITY_CHARS=3000
# Se verdadeiro, propostas do Nym para preferências e interesses são aplicadas sem aprovação.
# Traços, descrição, estilo e relação sempre exigem sua aprovação. Padrão: falso.
NYM_IDENTITY_AUTO_APPLY=false

# Estilo de resposta do modelo
# Temperatura (0 a 2): mais alta = mais solto e variado. 0.8 costuma soar mais natural.
NYM_TEMPERATURE=0.8
# Limite de tokens por resposta (0 = sem limite)
NYM_NUM_PREDICT=0
# Janela de contexto pedida ao Ollama, em tokens (0 = padrão do Ollama).
# Se for menor do que o que enviamos, o Ollama corta o COMEÇO (onde fica a identidade do Nym).
NYM_NUM_CTX=8192

# Velocidade
# Tempo que o Ollama mantém o modelo carregado sem uso (padrão do Ollama: 5m; recarregar demora). -1 = sempre.
NYM_KEEP_ALIVE=30m
# Modo de pensar (Gemma 4, Qwen 3): gera raciocínio oculto antes de responder, bem mais lento. false / true / auto
NYM_THINK=false
# Carregar o modelo assim que o Nym abre
NYM_WARM_UP=true

# Memória (Fase 3)
# Pausa (em minutos) que separa um episódio do seguinte
NYM_EPISODE_GAP_MINUTES=20
# Orçamento de caracteres de lembranças enviado ao modelo
NYM_MEMORY_CHARS=1500
# Consolidação automática em segundo plano (só roda com o chat parado)
NYM_MEMORY_WORKER=true
NYM_MEMORY_INTERVAL_SECONDS=60
NYM_MEMORY_IDLE_SECONDS=20
NYM_MEMORY_MAX_ATTEMPTS=3

# Somnium (sonhos): revisão da memória fora das conversas
NYM_DREAMS_ENABLED=true
NYM_DREAM_IDLE_MINUTES=30
NYM_DREAM_MIN_INTERVAL_HOURS=6
NYM_DREAM_MAX_PER_DAY=3
NYM_DREAM_MAX_SECONDS=300
NYM_DREAM_MAX_MODEL_CALLS=2
NYM_DREAM_MAX_MEMORIES=30
# Hora local (0-23) de um ciclo diário agendado; -1 desliga
NYM_DREAM_SCHEDULE_HOUR=-1

# Presença: o Nym pode puxar assunto (você pode ajustar também na página "Vida")
NYM_PRESENCE_ENABLED=true
NYM_PRESENCE_QUIET_START=23:00
NYM_PRESENCE_QUIET_END=08:00
# 0 = sem limite: ele chama sempre que tiver um motivo real (cada motivo é entregue uma vez)
NYM_PRESENCE_MAX_PER_DAY=0
NYM_PRESENCE_MIN_GAP_MINUTES=0
NYM_PRESENCE_WELCOME_BACK_HOURS=4

# Voz: o que faz o Nym soar como alguém, e não como chatbot
# Se a resposta cair num vício de chatbot (falar de si como IA sem você perguntar, se justificar sobre o sonho,
# pedir avaliação de si, textão), o Nym escreve UMA nova versão. Custa uma chamada extra ao modelo só nesses casos.
NYM_VOICE_RETRY=true
# Emoji nas respostas (falso = removidos)
NYM_ALLOW_EMOJI=false

# Tarefas (Fase 5): objetivos que o Nym executa com as próprias ferramentas
NYM_TASKS_ENABLED=true
NYM_TASK_INTERVAL_SECONDS=10
NYM_TASK_MAX_ATTEMPTS=3
NYM_TASK_TIMEOUT_SECONDS=30
NYM_GOAL_MAX_STEPS=5
NYM_GOAL_MAX_REPLANS=2
NYM_GOAL_MAX_MODEL_CALLS=8
NYM_GOAL_MAX_PLAN_ATTEMPTS=3

# Pesquisa na internet (Fase 6). Sem nada configurado, o Nym busca na web inteira pelo Tavily no modo sem chave
# (grátis, com limite de uso) e, se o Tavily falhar, na Wikipédia.
# Para mais buscas: crie uma conta grátis em https://app.tavily.com (1.000 créditos/mês, sem cartão) e cole a chave:
NYM_TAVILY_API_KEY=
NYM_TAVILY_ENABLED=true
NYM_SEARCH_LANG=pt
NYM_WEB_TIMEOUT_SECONDS=15
# Opcional: seu próprio SearXNG (buscador local, sem limite) ou uma chave da Brave Search API (paga desde 2026).
NYM_SEARXNG_URL=
NYM_BRAVE_API_KEY=

# Fase 7: o Nym lê o próprio código e PROPÕE melhorias na página Ateliê. Nada é aplicado sem você clicar em Aplicar.
NYM_SELF_CODE=true

# Fase 8: sentidos. A visão usa o próprio modelo do chat se ele enxergar (o Gemma 4 enxerga); senão, um modelo com
# visão do Ollama aqui. Câmera e tela só abrem quando você clica.
NYM_VISION_MODEL=
# Guardar as imagens vistas em data/perceptions/ (padrão: só a descrição fica)
NYM_KEEP_IMAGES=false
# Assistir vídeos: instale (opcional) `pip install yt-dlp` para ele ouvir pelas legendas, e o ffmpeg
# (winget install Gyan.FFmpeg) para ele ver quadros do vídeo. Sem eles, ele vê só as miniaturas.
NYM_VIDEO_MAX_MINUTES=90
NYM_VIDEO_FRAMES=4

# Usar no celular pela rede local (mesmo Wi-Fi). Com true o Nym escuta na rede e cada aparelho precisa ser pareado
# com um código mostrado no computador (botão "📱 Celular"). O Windows pode pedir para liberar no firewall.
NYM_LAN=false
